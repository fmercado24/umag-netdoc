# Copia este archivo como .env y ajusta los valores.

# --- Backend ---------------------------------------------------------------
NETDOC_ENTORNO=desarrollo

# SQLite (por defecto, no requiere servicios externos)
NETDOC_DATABASE_URL=sqlite:///./umag_netdoc.db

# PostgreSQL (cuando se migre; requiere `pip install -r requirements-postgres.txt`)
# NETDOC_DATABASE_URL=postgresql+psycopg://netdoc:netdoc@localhost:5432/umag_netdoc

# Orígenes permitidos para CORS, separados por coma
NETDOC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token compartido para los webhooks de estado (Zabbix y Alertmanager).
# Si queda vacío, esos endpoints quedan deshabilitados.
NETDOC_MONITOREO_TOKEN=
# Minutos de caída antes de marcar "en falla", si el evento informa los minutos
# NETDOC_MONITOREO_MINUTOS_FALLA=10

# Conector con Zabbix (python -m app.scripts.sincronizar zabbix), Zabbix 6.4+
# NETDOC_ZABBIX_URL=https://zabbix.umag.cl/api_jsonrpc.php
# NETDOC_ZABBIX_TOKEN=
# NETDOC_ZABBIX_PLANTILLAS=Network Generic Device by SNMP
# NETDOC_ZABBIX_TIPOS=SW,RT,AP,UPS,SV,PBX,ONT,MC

# --- Monitoreo con Docker (docker compose --profile monitoreo) -------------
# Clave del usuario admin de Grafana
# NETDOC_GRAFANA_CLAVE=
# Para que los contenedores alcancen la API: NETDOC_API_HOST=0.0.0.0 ./iniciar.sh

# --- Frontend --------------------------------------------------------------
# Se lee desde frontend/.env (ver frontend/.env.example)
# VITE_API_URL=http://localhost:8000
