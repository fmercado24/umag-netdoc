# Copia este archivo como .env y ajusta los valores. .env no se versiona.

# --- Backend ---------------------------------------------------------------
NETDOC_ENTORNO=desarrollo

# SQLite (por defecto, no requiere servicios externos)
NETDOC_DATABASE_URL=sqlite:///./umag_netdoc.db

# PostgreSQL (cuando se migre; requiere `pip install -r requirements-postgres.txt`)
# NETDOC_DATABASE_URL=postgresql+psycopg://netdoc:<clave>@localhost:5432/umag_netdoc
# NETDOC_POSTGRES_CLAVE=

# Teselas de los planos: el visor se mueve con fluidez sobre láminas pesadas.
# Generarlas toma ~1 GB de memoria unos segundos por lámina grande; con 0 no se
# generan y el visor muestra la lámina original (más lento).
# NETDOC_TESELAS=1

# --- Acceso: un único administrador (ver docs/seguridad.md) -----------------
# NETDOC_ADMIN_USUARIO=admin-netdoc
# El hash de la contraseña no tiene valor por omisión y no se escribe a mano:
#   cd backend && .venv/bin/python -m app.scripts.definir_clave
# NETDOC_ADMIN_CLAVE_HASH=
# Intentos fallidos por equipo y entre todos, y minutos que cuenta cada uno
# NETDOC_INGRESO_INTENTOS=3
# NETDOC_INGRESO_INTENTOS_GLOBALES=30
# NETDOC_INGRESO_BLOQUEO_MINUTOS=15
# Duración máxima de una sesión y minutos que dura sin actividad
# NETDOC_SESION_HORAS=12
# NETDOC_SESION_INACTIVIDAD_MINUTOS=30
# Tamaño máximo de un plano o fotografía que se carga por la API
# NETDOC_CARGA_MAX_MB=100

# Token compartido con los sistemas que no pueden iniciar sesión: los webhooks de
# estado (Zabbix y Alertmanager) y las lecturas de /metrics y /api/v1/integraciones
# (Prometheus, NetBox, GLPI). Si queda vacío, ese acceso queda deshabilitado.
# Generarlo con: openssl rand -hex 24
NETDOC_MONITOREO_TOKEN=
# Minutos de caída antes de marcar "en falla", si el evento informa los minutos
# NETDOC_MONITOREO_MINUTOS_FALLA=10

# Conector con Zabbix (python -m app.scripts.sincronizar zabbix), Zabbix 6.4+
# NETDOC_ZABBIX_URL=https://zabbix.umag.cl/api_jsonrpc.php
# NETDOC_ZABBIX_TOKEN=
# NETDOC_ZABBIX_PLANTILLAS=Network Generic Device by SNMP
# NETDOC_ZABBIX_TIPOS=SW,RT,AP,UPS,SV,PBX,ONT,MC

# --- Monitoreo con Docker (docker compose --profile monitoreo) -------------
# Clave del usuario admin de Grafana
# NETDOC_GRAFANA_CLAVE=
# NetDoc debe atender en la red, por HTTPS: NETDOC_API_HOST=0.0.0.0 ./iniciar.sh
